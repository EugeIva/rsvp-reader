{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RSVP Reader",
  "version": "0.1.0",
  "identifier": "com.eugene.rsvp-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: book: http://book.localhost",
        "media-src": "'self' data: blob: book: http://book.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "EPUB, FB2, MOBI and TXT reader with page and RSVP (speed reading) modes",
    "copyright": "Copyright © 2026 eugene",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "fileAssociations": [
      {
        "ext": ["epub"],
        "contentTypes": ["org.idpf.epub-container"],
        "name": "EPUB book",
        "description": "EPUB book",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": ["fb2"],
        "name": "FB2 book",
        "description": "FictionBook 2 book",
        "mimeType": "application/x-fictionbook+xml",
        "role": "Viewer"
      },
      {
        "ext": ["mobi", "azw3", "azw", "prc"],
        "name": "Kindle book",
        "description": "Kindle book (MOBI, AZW3)",
        "mimeType": "application/x-mobipocket-ebook",
        "role": "Viewer"
      },
      {
        "ext": ["txt"],
        "contentTypes": ["public.plain-text"],
        "name": "Plain text",
        "description": "Plain text",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
