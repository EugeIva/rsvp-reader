{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RSVP Reader",
  "version": "0.1.0",
  "identifier": "com.eugene.rsvp-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: epub: http://epub.localhost",
        "media-src": "'self' data: blob: epub: http://epub.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "EPUB reader with page and RSVP (speed reading) modes",
    "copyright": "Copyright © 2026 eugene",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
